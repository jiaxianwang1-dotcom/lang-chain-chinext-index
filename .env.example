OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# KIMI（Moonshot / Kimi for Coding）
# 标准 API: baseURL=https://api.moonshot.cn/v1  model=moonshot-v1-32k
# Coding API: baseURL=https://api.kimi.com/coding/v1  model=kimi-for-coding
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Kimi CLI 配置（使用方案1：通过 kimi CLI 调用 Kimi for Coding）
# 1. 安装 kimi CLI: pip install kimi-cli
# 2. 配置 ~/.kimi/config.toml（provider + model）
# 3. 设置 USE_KIMI_CLI=true 即可切换
USE_KIMI_CLI=false
KIMI_CLI_PATH=
KIMI_CLI_TIMEOUT_MS=120000

# LangSmith（可选）
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=stock-index-agent

# 短信网关（指数预测智能体）
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_PHONE=15136489941
